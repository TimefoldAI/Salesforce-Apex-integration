<?xml version="1.0" encoding="UTF-8"?>
<!-- What a user needs to run an optimisation.

     Three things, and the first two are easy to forget:

       * the external credential principal. Without it every callout fails
         with an unhelpful CalloutException, because the platform will not
         hand the key to a user who has not been granted the principal.
       * field-level access to Timefold_Run__c. Apex runs in system context
         and writes these happily, so the classes compile and a run works -
         but the API and every list view enforce field-level security, so
         without this the fields report as not existing at all:
         "No such column 'Solver_Status__c' on entity 'Timefold_Run__c'".
         Required fields are left out: they are always visible, and
         Salesforce refuses a fieldPermissions entry for one.
       * the classes themselves. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Timefold Integration</label>
    <description>Run Timefold optimisation from this org: the Apex entry points, the API credential, and the run log.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>Timefold_API-TimefoldApiKey</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <classAccesses>
        <apexClass>TimefoldClient</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldJob</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldPlanner</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldRosterExtract</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldRosterRequest</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldRosterWriteback</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldRoutesExtract</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldRoutesRequest</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldRoutesWriteback</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldRules</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TimefoldSeed</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Timefold_Run__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Timefold_Setting__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Timefold_Run__c.Error__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Timefold_Run__c.Finished__c</field>
