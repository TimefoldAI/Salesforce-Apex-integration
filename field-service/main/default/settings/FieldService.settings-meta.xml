<?xml version="1.0" encoding="UTF-8"?>
<!-- Switches Field Service on: the toggle at Setup > Field Service Settings,
     as metadata, so it can be deployed instead of clicked. Turning it on
     creates the standard objects this integration reads - ServiceAppointment,
     ServiceResource, ServiceTerritory, Shift and the rest.

     Deliberately in its own package directory, not in force-app. An org
     preference is not the same kind of thing as a class: nobody expects
     "deploy the integration" to change an org-wide switch, so setup.sh asks
     first and deploys only this directory when the answer is yes.

     Only the one preference. The managed package, the notification settings
     and the permission set licences are all separate, and none of them is
     needed for this integration: they add the Dispatcher Console's Gantt and
     map, which are nice to look at and not required to plan anything. -->
<FieldServiceSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <fieldServiceOrgPref>true</fieldServiceOrgPref>
</FieldServiceSettings>
